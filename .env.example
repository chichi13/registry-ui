# ============================================
# Docker Registry UI - Environment Variables
# ============================================

# --------------------------------------------
# Application Configuration
# --------------------------------------------

# Node environment (development | production)
NODE_ENV=production

# --------------------------------------------
# Logging Configuration
# --------------------------------------------

# Server-side log level (0-5)
# 0 = silent (no logs)
# 1 = error (errors only) - default in production
# 2 = warn (errors + warnings)
# 3 = info (errors + warnings + info)
# 4 = debug (all except trace) - default in development
# 5 = trace (absolutely everything)
# If not set, auto-detects: 4 in development, 1 in production
LOG_LEVEL=3

# Client-side log level (0-5, same scale as LOG_LEVEL)
# Controls browser console logging
# If not set, auto-detects: 4 in development, 1 in production
NUXT_PUBLIC_LOG_LEVEL=3

# --------------------------------------------
# Server Configuration
# --------------------------------------------

# Host to bind the server (MUST be 127.0.0.1 in production for security)
# Only expose through reverse proxy with authentication
HOST=127.0.0.1

# Port for the application server
PORT=3000

# --------------------------------------------
# Docker Registry Configuration
# --------------------------------------------

# URL of the Docker Registry V2 API
# Example: https://registry.example.com
REGISTRY_URL=https://registry.example.com

# Public-facing Docker Registry URL for pull commands (optional)
# This is the URL users should use in "docker pull" commands
# Example: registry.example.com (without protocol)
# If not set, falls back to REGISTRY_URL (with protocol removed)
REGISTRY_PUBLIC_URL=registry.example.com

# Username for Docker Registry authentication
# Leave empty if registry has anonymous read access
REGISTRY_USERNAME=admin

# Password for Docker Registry authentication
# SECURITY: Keep this secret! Never commit to version control
REGISTRY_PASSWORD=

# Bearer token cache TTL in seconds (default: 300 = 5 minutes)
# Tokens are cached server-side to reduce registry authentication calls
REGISTRY_TOKEN_CACHE_TTL=300

# Request timeout in milliseconds (default: 10000 = 10 seconds)
# Increase for slow networks, decrease for faster failure detection
REGISTRY_REQUEST_TIMEOUT=10000

# Maximum retry attempts for failed requests (default: 3)
# Set to 0 to disable retries (fail fast)
REGISTRY_MAX_RETRIES=3

# --------------------------------------------
# Optional Features
# --------------------------------------------

# Enable user logging from X-Forwarded-User header (true | false)
# Requires reverse proxy to set X-Forwarded-User header
# Used for audit logging and user attribution
ENABLE_USER_LOGGING=true
