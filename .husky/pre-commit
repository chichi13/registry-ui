#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Ensure bun is available in PATH
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

echo "Running pre-commit checks..."

# Run linter with strict mode (no warnings allowed)
echo "Linting code..."
bun run lint --max-warnings 0 || {
  echo "Linting failed. Please fix the errors above."
  exit 1
}

# Check code formatting
echo "Checking code formatting..."
bun run prettier:check || {
  echo "Code formatting check failed. Run 'bun run prettier:fix' to fix."
  exit 1
}

# Type checking with TypeScript
echo "Type checking..."
bunx vue-tsc --noEmit || {
  echo "Type checking failed. Please fix the errors above."
  exit 1
}

echo "Pre-commit checks passed!"
